#!/bin/bash
# M4: full training run on a GPU node, as a BATCH job.
#
# Deliberately not interactive. A real training run takes hours, and an
# interactive job dies the moment the browser tab reloads or the connection
# drops. Batch jobs survive all of that and write their output to a file.
#
# Submit from a frontend (e.g. skirit):
#     qsub ~/projects/click-segmenter/scripts/metacentrum/train.pbs
#     qstat -u $USER
#     tail -f ~/projects/click-segmenter/cs-train.o<jobid>     # watch live
#
# gpu_cap=compute_75 is essential: the NGC container ships CUDA kernels only
# for sm_75 and newer, so an older card (konos, grimbold) would pass
# torch.cuda.is_available() and then die at the first kernel launch.

#PBS -N cs-train
# 16 CPUs, not 8: the dataloader is the bottleneck (measured ~124ms/batch
# against ~15ms of actual GPU work), so CPU count sets throughput here.
# gpu_mem=30gb: at 384x512 depth-4 batch-32 the activations no longer fit a
# 16GB A4000, so keep the job off the smaller cards.
#PBS -l select=1:ncpus=16:ngpus=1:mem=48gb:scratch_local=50gb:gpu_cap=compute_75:gpu_mem=30gb
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

# $HOME is not stable across MetaCentrum nodes -- always use an absolute
# storage path in batch jobs. See export_data.pbs for the incident that
# prompted this.
HOME_DIR="/storage/brno2/home/$USER"
REPO="$HOME_DIR/projects/click-segmenter"
DATA_ROOT="$HOME_DIR/projects/ade20k-reference/dataset/ADE20K_2021_17_01/images/ADE"
IMAGE="/cvmfs/singularity.metacentrum.cz/NGC/PyTorch:25.02-py3.SIF"

# --auto-resume picks up outputs/checkpoints/latest.pt if it exists, so
# resubmitting this same script after a walltime kill continues the run rather
# than restarting it. Delete outputs/checkpoints/ to force a fresh start.
RESUME=""

# Extra flags for train_full.py, supplied at submission time:
#     qsub -v EXTRA_ARGS="--max-images 0" scripts/metacentrum/train.pbs
# This exists so that changing an experiment does not mean editing configs/ on
# the cluster. A dirtied checkout there blocks the `git pull` that every later
# job depends on, and a job launched from stale code has already cost two full
# runs. PBS -v does not survive into the container's environment on its own,
# so the value is interpolated into the command below.
EXTRA_ARGS="${EXTRA_ARGS:-}"
echo "extra args: ${EXTRA_ARGS:-(none)}"

# Which entry point to run. train_full.py is the click-conditioned model;
# train_slots.py is the slot architecture, which needs whole images rather than
# (image, instance) pairs and so has its own loop:
#     qsub -v TRAIN_SCRIPT=scripts/train_slots.py,EXTRA_ARGS="--max-images 0" ...
TRAIN_SCRIPT="${TRAIN_SCRIPT:-scripts/train_full.py}"
echo "train script: $TRAIN_SCRIPT"

echo "=== Node ==="
hostname -f
nvidia-smi
ls -d "$REPO" || { echo "FATAL: repo not found at $REPO"; exit 1; }

# The resnet34_unet arch needs ImageNet weights. torch caches them under
# TORCH_HOME, which must (a) live on shared storage so every node sees it and
# (b) not depend on $HOME, which differs per node. Compute nodes often have no
# internet, so if the cache is cold, fetch here only if we can; otherwise tell
# the user to run the wget once on a frontend (frontends have internet).
export TORCH_HOME="$HOME_DIR/.cache/torch"
# Both backbones: resnet34 for the click-conditioned model, resnet50 for the
# slot model. Caching whichever is missing costs nothing when it is already
# there, and means switching architectures does not fail on a node with no
# internet halfway through the queue wait.
for MODEL in resnet34-b627a593 resnet50-0676ba61; do
    WEIGHTS="$TORCH_HOME/hub/checkpoints/${MODEL}.pth"
    if [ ! -f "$WEIGHTS" ]; then
        echo "ImageNet weights for ${MODEL} not cached, attempting download..."
        mkdir -p "$(dirname "$WEIGHTS")"
        wget -q -O "$WEIGHTS" "https://download.pytorch.org/models/${MODEL}.pth" || {
            rm -f "$WEIGHTS"
            echo "FATAL: ${MODEL} weights not cached and this node has no internet."
            echo "Run this ONCE on a frontend (skirit), then resubmit:"
            echo "  mkdir -p $TORCH_HOME/hub/checkpoints"
            echo "  wget -O $WEIGHTS https://download.pytorch.org/models/${MODEL}.pth"
            exit 1
        }
    fi
    echo "ImageNet weights ${MODEL}: $(ls -la "$WEIGHTS" | awk '{print $5}') bytes"
done

# PBS only copies its own .o file back when the job ends, which is useless for
# watching a 12-hour run. Tee everything into the repo as well so progress can
# be followed live with: tail -f ~/projects/click-segmenter/outputs/train.log
LIVE_LOG="$REPO/outputs/train.log"
mkdir -p "$(dirname "$LIVE_LOG")"
echo "Live log: $LIVE_LOG"

echo "=== Training ==="
# Pass the dataset location explicitly rather than letting configs/data.yaml's
# "~" expand. Two earlier failures came from $HOME differing per node: a job on
# an elixir node looked in /storage/praha5-elixir/..., another on a natur node
# in /storage/praha2-natur/..., while the data lives on brno2. Overriding HOME
# for the container does not work either -- Singularity explicitly refuses it
# ("Overriding HOME environment variable ... is not permitted"). An absolute
# path on the command line is the only reliable option.
singularity exec --nv \
    --bind "$HOME_DIR:$HOME_DIR" \
    --bind "$SCRATCHDIR:$SCRATCHDIR" \
    --env TORCH_HOME="$TORCH_HOME" \
    "$IMAGE" bash -c "
set -euo pipefail
cd '$REPO'
# Echoed here, inside the teed block, so it reaches outputs/train.log and can be
# checked while the job runs. The same echo before the container goes only to
# the PBS .o file, which PBS does not write until the job ends -- too late to
# catch a run that started with the wrong experiment settings.
echo 'train script: $TRAIN_SCRIPT'
echo 'extra args: ${EXTRA_ARGS:-(none)}'
# Which card this landed on, in the live log rather than only in the PBS .o
# file. Throughput varies several-fold across the eligible GPUs, so an epoch
# time is uninterpretable without knowing which one produced it.
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader || true
python3 -c 'import torch; print(\"torch\", torch.__version__, \"cuda\", torch.cuda.is_available())'
python3 -u '$TRAIN_SCRIPT' --data-root '$DATA_ROOT' --auto-resume ${RESUME:+--resume '$RESUME'} $EXTRA_ARGS
" 2>&1 | tee "$LIVE_LOG"

echo "=== Results ==="
echo "history:     $REPO/outputs/history.json"
echo "checkpoints: $REPO/outputs/checkpoints/"
ls -la "$REPO/outputs/checkpoints/" || true

clean_scratch
echo "=== Done ==="
