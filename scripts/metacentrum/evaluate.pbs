#!/bin/bash
# Multi-click evaluation of a checkpoint (mIoU@k, NoC@85/90) on a GPU node.
#
# Submit from a frontend (skirit). Everything specific to the run comes in
# through EVAL_ARGS, so nothing in the repo has to be edited on the cluster:
#
#     qsub -v EVAL_ARGS="--checkpoint results/run-7/best.pt --split val --max-instances 5000 --output outputs/eval/run7-val.json" \
#          scripts/metacentrum/evaluate.pbs
#
# To compare inference options, submit once per option and diff the JSON:
#     EVAL_ARGS="... --selection consistent --output outputs/eval/run7-val-consistent.json"
#     EVAL_ARGS="... --flip-tta --output outputs/eval/run7-val-tta.json"
#
# Cost: one forward pass per click per instance. 5,000 instances x 20 clicks
# is 100k passes at 384x512 -- around 20-40 minutes on an A40-class card, most
# of it the CPU-side click placement. The full validation split (49k) is ~10x.

#PBS -N cs-eval
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb:scratch_local=20gb:gpu_cap=compute_75:gpu_mem=16gb
#PBS -l walltime=6:00:00
#PBS -j oe

set -euo pipefail

HOME_DIR="/storage/brno2/home/$USER"
REPO="$HOME_DIR/projects/click-segmenter"
DATA_ROOT="$HOME_DIR/projects/ade20k-reference/dataset/ADE20K_2021_17_01/images/ADE"
IMAGE="/cvmfs/singularity.metacentrum.cz/NGC/PyTorch:25.02-py3.SIF"

EVAL_ARGS="${EVAL_ARGS:-}"
if [ -z "$EVAL_ARGS" ]; then
    echo "FATAL: EVAL_ARGS is empty. At minimum pass --checkpoint, e.g."
    echo '  qsub -v EVAL_ARGS="--checkpoint results/run-7/best.pt --split val" scripts/metacentrum/evaluate.pbs'
    exit 1
fi

echo "=== Node ==="
hostname -f
nvidia-smi
ls -d "$REPO" || { echo "FATAL: repo not found at $REPO"; exit 1; }

# No ImageNet download is needed: the architecture is rebuilt from the
# checkpoint's own weights with pretrained=False.
export TORCH_HOME="$HOME_DIR/.cache/torch"

LIVE_LOG="$REPO/outputs/eval.log"
mkdir -p "$(dirname "$LIVE_LOG")"
echo "Live log: $LIVE_LOG"

echo "=== Evaluation ==="
singularity exec --nv \
    --bind "$HOME_DIR:$HOME_DIR" \
    --bind "$SCRATCHDIR:$SCRATCHDIR" \
    --env TORCH_HOME="$TORCH_HOME" \
    "$IMAGE" bash -c "
set -euo pipefail
cd '$REPO'
echo 'eval args: $EVAL_ARGS'
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader || true
python3 -u scripts/evaluate.py --data-root '$DATA_ROOT' --device cuda $EVAL_ARGS
" 2>&1 | tee "$LIVE_LOG"

clean_scratch
echo "=== Done ==="
