#!/bin/bash
# Exports the full ADE20K HF mirror (1aurent/ADE20K) directly on MetaCentrum --
# no need to download the ~6GB / ~27k images locally first. Runs as a batch
# job (not on a frontend) since this is real CPU/network/disk work, not the
# "light setup" frontends are meant for.
#
# Prereq: setup_env.sh has already been run once (venv + repo clones exist).
#
#   qsub ~/projects/click-segmenter/scripts/metacentrum/export_data.pbs
#   qstat -xu <username>
#
# Writes into ~/projects/ade20k-reference/dataset/ADE20K_2021_17_01/images/ADE
# -- the exact path configs/data.yaml already points at, so nothing else
# needs to change once this finishes. No GPU needed for this step.
#
# Walltime is generous (train split alone is ~25,574 images) -- shrink it
# once you've seen how long a first run actually takes.

#PBS -N cs-export-ade20k
#PBS -l select=1:ncpus=4:mem=8gb:scratch_local=20gb
#PBS -l walltime=6:00:00
#PBS -j oe

set -euo pipefail

module load python-modules || echo "module name may have changed -- check 'module avail python'"
source "$HOME/venvs/click-segmenter/bin/activate"

cd "$HOME/projects/click-segmenter"
OUTPUT_ROOT="$HOME/projects/ade20k-reference/dataset/ADE20K_2021_17_01/images/ADE"

echo "=== Exporting train split ==="
python scripts/export_ade20k.py --split train --output-root "$OUTPUT_ROOT"

echo "=== Exporting validation split ==="
python scripts/export_ade20k.py --split validation --output-root "$OUTPUT_ROOT"

echo "=== Done. Row counts: ==="
find "$OUTPUT_ROOT" -name "*.jpg" | wc -l
