#!/bin/bash
# Exports the ADE20K HF mirror (1aurent/ADE20K) into the on-disk layout that
# src/data/ade20k.py expects, directly on MetaCentrum. Nothing needs to be
# downloaded to your laptop.
#
# Self-contained: builds its own small venv on first run (datasets + pyarrow +
# pillow only, no torch), so setup_env.sh is NOT required.
#
# Submit from a frontend (qsub is not available inside the OnDemand Jupyter
# container):
#     ssh <username>@tarkil.metacentrum.cz
#     qsub ~/projects/click-segmenter/scripts/metacentrum/export_data.pbs
#     qstat -xu <username>
#
# Tune how much to export with LIMIT below. The full train split is 25,574
# images and ~700k instance masks, which is a LOT of small files -- see the
# quota warning further down. Starting with a few thousand images is usually
# the faster route to a working model.

#PBS -N cs-export-ade20k
#PBS -l select=1:ncpus=4:mem=16gb:scratch_local=100gb
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

# How many images to export per split. Empty means "all".
# 3000 train / 600 val is a good first target: enough to train a genuinely
# useful model, small enough to finish in well under an hour.
LIMIT_TRAIN=3000
LIMIT_VAL=600

# $HOME is NOT stable across MetaCentrum nodes -- you have a home directory on
# several storages, and which one $HOME points at depends on where the job
# lands. A first attempt failed because the job ran on an elixir node where
# $HOME resolved to /storage/praha5-elixir/... instead of brno2. Always use an
# absolute storage path in batch jobs.
HOME_DIR="/storage/brno2/home/$USER"
REPO="$HOME_DIR/projects/click-segmenter"
OUTPUT_ROOT="$HOME_DIR/projects/ade20k-reference/dataset/ADE20K_2021_17_01/images/ADE"

# The NGC container already ships a working Python. Using it avoids both the
# missing `python-modules` modulefile and the system Python's missing ensurepip.
IMAGE="/cvmfs/singularity.metacentrum.cz/NGC/PyTorch:25.02-py3.SIF"

echo "=== Node ==="
hostname -f
df -h "$SCRATCHDIR" | tail -1
ls -d "$REPO" || { echo "FATAL: repo not found at $REPO"; exit 1; }

# Keep the Hugging Face cache and the pip install on node-local scratch rather
# than the shared home filesystem: the parquet shards total ~6GB.
export HF_HOME="$SCRATCHDIR/hf-cache"
export PYTHONUSERBASE="$SCRATCHDIR/pylibs"
mkdir -p "$HF_HOME" "$PYTHONUSERBASE"

echo "=== Running export inside $IMAGE ==="
singularity exec \
    --bind "$HOME_DIR:$HOME_DIR" \
    --bind "$SCRATCHDIR:$SCRATCHDIR" \
    --env HF_HOME="$HF_HOME" \
    --env PYTHONUSERBASE="$PYTHONUSERBASE" \
    "$IMAGE" bash -c "
set -euo pipefail
cd '$REPO'

echo '--- installing export deps (datasets, pyarrow) ---'
pip install --user --quiet datasets pyarrow

echo '--- exporting train split (limit: ${LIMIT_TRAIN:-all}) ---'
python3 scripts/export_ade20k.py --split train --output-root '$OUTPUT_ROOT' \
    ${LIMIT_TRAIN:+--limit $LIMIT_TRAIN}

echo '--- exporting validation split (limit: ${LIMIT_VAL:-all}) ---'
python3 scripts/export_ade20k.py --split validation --output-root '$OUTPUT_ROOT' \
    ${LIMIT_VAL:+--limit $LIMIT_VAL}
"

echo "=== Result ==="
echo "images exported: $(find "$OUTPUT_ROOT" -name '*.jpg' | wc -l)"
echo "instance masks:  $(find "$OUTPUT_ROOT" -name 'instance_*.png' | wc -l)"

clean_scratch
echo "=== Done ==="
